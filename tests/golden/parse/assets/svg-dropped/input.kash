// spec: 3a, 7
// An SVG whose `<image>` references a file is reported once, at its first use; `data:` images and text are kept.
diagram "svg dropped" size (300,200)
image linked "linked.svg" at (20,20) size (60,60)
box again "Again" at (120,20) size (120,40) icon="linked.svg"
image inline "inline.svg" at (20,110) size (60,60)
