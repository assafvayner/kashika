// spec: 5, 7
// A line label wider than the run it sits on gets the run it needs; between bare arrowheads, `label-side` is offered too.
diagram "label too wide" size (400,200)
box a "A" at (20,20) size (100,40)
box b "B" at (180,20) size (100,40)
arrow ab a.right -> b.left label="a long label here"
arrow short (20,140) -> h 40 start=arrow label="hello"
