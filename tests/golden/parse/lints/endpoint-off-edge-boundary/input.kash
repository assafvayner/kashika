// spec: 7
// `endpoint-off-edge` flags a literal end 8px from an outline and not one 8.1px away, at either end.
diagram "off edge boundary" size (800,600)
box a at (100,100) size (100,80)
line end_flag (0,110) -> (92,110)
line end_clean (0,125) -> (91.9,125)
line start_flag (92,140) -> (0,140)
line start_clean (91.9,155) -> (0,155)
