// spec: 3, 7
// `margin=` sets the room after a fitted canvas, so it is an error with a fixed size, and it
// must be at least 0. An `auto` axis is only for boxes, groups and the diagram.
diagram "margins" size (200,100) margin=10
image i "missing.png" at (10,10) size (auto, 50)
box a "A" at (10,10) size (40,40)
