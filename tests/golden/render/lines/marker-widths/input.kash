// spec: 5
// raster: png
// Every line end at stroke widths 1, 1.5 and 4: past the default 1.5 the ends grow with the stroke.
diagram "marker widths" size (580,440) background=white
text "1" at (230,20)
text "1.5" at (370,20)
text "4" at (510,20)
text "arrow" at (150,50) align=right
line (170,50) -> h 120 end=arrow stroke-width=1
line (310,50) -> h 120 end=arrow stroke-width=1.5
line (450,50) -> h 120 end=arrow stroke-width=4
