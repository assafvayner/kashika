// spec: 3a
// A custom unit-path shape with a cross-bar subpath and custom text area.
diagram "custom" size (300,160)
shape lb {
  path "M 0 0.5 L 0.5 0 L 1 0.5 L 0.5 1 Z  M 0.2 0.5 L 0.8 0.5"
  outline 1
  text-area (0.25,0.55,0.5,0.3)
}
box a "LB" at (20,20) size (160,120) shape=lb style=service
