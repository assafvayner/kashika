// spec: 6
// `font-size`/`text-align` and the aliases `size`/`align` draw the same text.
diagram "names" size (360,140)
text "**font-size=16** text-align=left" at (20,30) font-size=16 text-align=left
text "**size=16** align=left" at (20,60) size=16 align=left
box a at (20,80) size (320,50) {
  text "font-size=11 text-align=right" font-size=11 text-align=right
  text "size=11 align=right" size=11 align=right
}
