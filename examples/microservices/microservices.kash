diagram "E-commerce microservices" size (1000,620) kashika="0.1.0"

box web "Browser" at (8,150) size (130,60) style=external icon="browser"
box mobile "Mobile app" at (8,330) size (130,60) style=external icon="person"

group vpc "VPC" at (200,20) size (780,580) {
  group pub "Public subnet" at (20,50) size (200,500) {
    box lb "Load balancer" at (20,120) size (160,60) style=service icon="cloud"
    box gw "API gateway" at (20,320) size (160,60) style=service icon="server"
  }
  group priv "Private subnet" at (270,50) size (490,500) {
    box orders "Orders" at (30,100) size (130,60) style=service icon="server"
    box payments "Payments" at (30,220) size (130,60) style=service icon="lock"
    box inventory "Inventory" at (30,340) size (130,60) style=service icon="server"
    box queue "Message queue" at (230,100) size (170,60) style=queue icon="queue"
    box cache "Redis cache" at (230,340) size (150,60) style=datastore
    box db "Postgres" at (370,200) size (100,100) shape=cylinder style=datastore
  }
}

junction fan at (450, gw.right.y)
junction tap at (450, payments.left.y)

line web_lb: web.right -> x 170 -> vh lb.left@0.3 end=arrow label@0.25="HTTPS"
line mobile_lb: mobile.right -> x 170 -> vh lb.left@0.7 end=arrow label@0.25="HTTPS"
line lb_gw: lb.bottom -> gw.top end=arrow
line gw_orders: gw.right -> x 450 -> y orders.left -> orders.left end=arrow
line tap_payments: tap -> payments.left end=arrow
line fan_inventory: fan -> y inventory.left -> inventory.left end=arrow
line orders_queue: orders.right -> queue.left end=arrow label="publish"
line queue_payments: queue.bottom -> y 260 -> hv payments.top end=arrow label="consume"
line payments_db: payments.right -> db.left end=arrow
line orders_db: orders.top -> y 150 -> x db.top -> y db.top end=arrow
line inv_cache: inventory.right -> cache.left end=arrow
line inv_db: inventory.bottom -> y 550 -> x db.bottom -> y db.bottom end=arrow
