diagram "E-commerce microservices" kashika="0.1.0"

box web "Browser" at (20, 150) size (130, 60) style=external icon="browser"
box mobile "Mobile app" at (20, 330) size (130, 60) style=external icon="mobile"

group vpc "VPC" at (250, 20) {
  group pub "Public subnet" at (20, 50) size (200, 500) {
    box lb "Load balancer" at (20, 120) size (160, 60) style=service icon="load-balancer"
    box gw "API gateway" at (20, 320) size (160, 60) style=service icon="gateway"
  }
  group priv "Private subnet" at (270, 50) size (490, 500) {
    box orders "Orders" at (30, 100) size (130, 60) style=service icon="server"
    box payments "Payments" at (30, 220) size (130, 60) style=service icon="lock"
    box inventory "Inventory" at (30, 340) size (130, 60) style=service icon="server"
    box queue "Message queue" at (230, 100) size (170, 60) style=queue icon="queue"
    box cache "Redis cache" at (230, 340) size (150, 60) style=datastore icon="cache"
    box db "Postgres" at (370, 200) size (100, 100) shape=cylinder style=datastore
  }
}

junction fan at (500, gw.right.y) dot
junction tap at (500, payments.left.y) dot

arrow web_lb web.right -> x 220 -> vh lb.left@0.3 label@0.2="HTTPS" label-side=above
arrow mobile_lb mobile.right -> x 220 -> vh lb.left@0.7 label@0.13="HTTPS" label-side=above
arrow lb_gw lb.bottom -> gw.top
arrow gw_orders gw.right -> x 500 -> y orders.left -> orders.left
arrow tap_payments tap -> payments.left
arrow fan_inventory fan -> y inventory.left -> inventory.left
arrow orders_queue orders.right -> queue.left label="publish" label-side=above
arrow queue_payments queue.bottom -> y 260 -> hv payments.top label="consume"
arrow payments_db payments.right -> db.left
arrow orders_db orders.top -> y 150 -> x db.top -> y db.top
arrow inv_cache inventory.right -> cache.left
arrow inv_db inventory.bottom -> y 550 -> x db.bottom -> y db.bottom
