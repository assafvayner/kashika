diagram "Analytics data pipeline" kashika="0.1.0"

text "**Analytics data pipeline**" at (40, 50) font-size=22 text-align=left
text "Events to dashboards; `exactly-once` from Kafka onward" at (40, 80) font-size=13 text-align=left muted

box src "Event sources" at (40, 200) size (180, 110) style=external sublabel="web, mobile; 50k ev/s"
box kafka "Kafka ingestion" at src.tr+(70, 0) size (180, 110) pin=tl style=queue sublabel="Kafka 3.7, 12 partitions"
box stream at kafka.tr+(70, 0) size (180, 110) pin=tl style=service text-align=left {
  text "**Stream processing**"
  text "Flink 1.19, p99 < 2 s" font-size=11 muted
  text "• `exactly-once` sinks" font-size=12
  text "• 5 min windows" font-size=12
}
box lake at stream.tr+(70, 0) size (180, 110) pin=tl style=datastore text-align=left {
  text "**Raw data lake**"
  text "S3 + Parquet, 11 nines" font-size=11 muted
  text "• partitioned by `dt`" font-size=12
  text "• 400 d retention" font-size=12
}
box batch "Batch transforms" at lake.tr+(70, 0) size (180, 110) pin=tl style=service sublabel="dbt + Spark, hourly"
box wh "Warehouse" at batch.tr+(70, 0) size (180, 110) pin=tl style=datastore sublabel="Snowflake, 15 min freshness"
box bi "BI dashboards" at wh.tr+(70, 0) size (180, 110) pin=tl style=external sublabel="Looker, load < 3 s"
box fs at lake.bl+(0, 70) size (180, 100) pin=tl style=datastore text-align=left {
  text "**ML feature store**"
  text "Redis + Feast, p99 < 10 ms" font-size=11 muted
  text "• online + offline" font-size=12
}

arrow l_src src.right -> kafka.left label="events" label-side=above
arrow l_kafka kafka.right -> stream.left label="topics" label-side=above
arrow l_stream stream.right -> lake.left label="sink" label-side=above
arrow l_lake lake.right -> batch.left label="read" label-side=above
arrow l_batch batch.right -> wh.left label="load" label-side=above
arrow l_wh wh.right -> bi.left label="query" label-side=above
arrow l_feat stream.bottom -> vh fs.left label@0.8="features" label-side=above
arrow l_scores fs.right -> x bi.bottom -> bi.bottom label="scores"
arrow l_snap src.top -> y 150 -> hv batch.top stroke-style=dashed label="nightly DB snapshots"
